rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{parentId} {
      function ownsProfile() {
        return request.auth != null && request.auth.uid == parentId;
      }
      function validProfile() {
        let data = request.resource.data;
        return data.keys().hasAll(['nickname', 'ageBand', 'updatedAt'])
          && data.keys().hasOnly(['nickname', 'ageBand', 'avatar', 'updatedAt'])
          && data.nickname is string
          && data.nickname.size() >= 1
          && data.nickname.size() <= 40
          && data.nickname.matches('.*\\S.*')
          && data.ageBand in ['2-3', '4-5', '6-7']
          && (!('avatar' in data) || data.avatar in ['girl', 'boy'])
          && data.updatedAt == request.time;
      }
      allow get, delete: if ownsProfile();
      allow create, update: if ownsProfile() && validProfile();
    }
  }
}
